# Copy this file to .env and fill in your keys
# For Streamlit Cloud: set these in the Secrets dashboard instead

# Primary LLM - Google Gemini (free: 15 RPM, 1M tokens/day)
# Get key FREE at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Fallback LLM - Mistral (free tier)
MISTRALAI_API_KEY=your_mistral_api_key_here

# Web search tool - Tavily
# Get key FREE at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here